# Backend settings
FINDASH_APP_NAME=FinDash API
FINDASH_ENV=development
FINDASH_APP_VERSION=0.1.0
FINDASH_LOG_LEVEL=INFO
DATABASE_URL=postgresql://findash:findash@db:5432/findash
JWT_SECRET_KEY=super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FINDASH_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Postgres
POSTGRES_USER=findash
POSTGRES_PASSWORD=findash
POSTGRES_DB=findash

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@findash.com
PGADMIN_DEFAULT_PASSWORD=admin123
